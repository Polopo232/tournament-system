{
  "info": {
    "name": "Tournament System API",
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "description": "Täielik API kogumik turniirisüsteemi testimiseks (Auth, Turniirid, Registreerimine, Tabel, Matðid, Elo ja Kasutajad).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tournamentId",
      "value": "2"
    },
    {
      "key": "matchId",
      "value": "5"
    },
    {
      "key": "playerId",
      "value": "4"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register Player",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newplayer\",\n  \"email\": \"newplayer@tournament.local\",\n  \"password\": \"Player123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login (Organizer - salvestab tokeni)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"organizer\",\n  \"password\": \"Organizer123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login (Player1 - salvestab tokeni)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"player1\",\n  \"password\": \"Player123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login (Admin - salvestab tokeni)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "2. Tournaments",
      "item": [
        {
          "name": "Get All Tournaments (Filter & Pagination)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tournaments?page=1&pageSize=6&sortBy=startDate"
          }
        },
        {
          "name": "Get Tournament By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tournaments/{{tournamentId}}"
          }
        },
        {
          "name": "Create Tournament (Organizer/Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tallinn CS2 Masters 2026\",\n  \"game\": \"CS2\",\n  \"description\": \"Ametlik CS2 1v1 turniir\",\n  \"format\": \"SingleElimination\",\n  \"maxPlayers\": 8,\n  \"startDate\": \"2026-12-10T18:00:00Z\"\n}"
            },
            "url": "{{baseUrl}}/api/tournaments"
          }
        },
        {
          "name": "Update Tournament (Organizer/Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tallinn CS2 Masters 2026 (Updated)\",\n  \"game\": \"CS2\",\n  \"description\": \"Uuendatud turniiri kirjeldus\",\n  \"format\": \"SingleElimination\",\n  \"status\": \"Registration\",\n  \"maxPlayers\": 16,\n  \"startDate\": \"2026-12-12T18:00:00Z\"\n}"
            },
            "url": "{{baseUrl}}/api/tournaments/{{tournamentId}}"
          }
        },
        {
          "name": "Delete Tournament (Organizer/Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/tournaments/{{tournamentId}}"
          }
        }
      ]
    },
    {
      "name": "3. Registrations & Bracket",
      "item": [
        {
          "name": "Register Current Player to Tournament",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/tournaments/{{tournamentId}}/register"
          }
        },
        {
          "name": "Generate Bracket (Organizer/Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/tournaments/{{tournamentId}}/bracket"
          }
        }
      ]
    },
    {
      "name": "4. Matches & Elo",
      "item": [
        {
          "name": "Record Match Result (Organizer/Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player1Score\": 11,\n  \"player2Score\": 7\n}"
            },
            "url": "{{baseUrl}}/api/matches/{{matchId}}/result"
          }
        },
        {
          "name": "Get Player Rating History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/players/{{playerId}}/rating-history"
          }
        }
      ]
    },
    {
      "name": "5. Users (Admin)",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Update User Role",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"Organizer\"\n}"
            },
            "url": "{{baseUrl}}/api/users/{{playerId}}/role"
          }
        }
      ]
    }
  ]
}